# ---------------------------------------------------------------------------
# UniFi WiFi Access Manager
# Copy to .env and fill in. Keep this file private (chmod 600 .env).
# ---------------------------------------------------------------------------

# --- App auth ---------------------------------------------------------------
# Users and password hashes live in the SQLite database. On a fresh install the
# Web UI asks you to create the first admin at /setup.
#
# APP_USERNAME/APP_PASSWORD are an OPTIONAL bootstrap account: if set, they are
# imported as the first admin on startup (useful for unattended installs) and
# are ignored once any user exists. Leave APP_PASSWORD empty to use /setup.
APP_USERNAME=admin
APP_PASSWORD=
# APP_PASSWORD_HASH=scrypt$16384$8$1$...
# Generate a bootstrap hash with:
#   docker compose run --rm app python -c \
#     "from app.auth import hash_password; print(hash_password('your-password'))"

# Must be a long random value. Generate with: openssl rand -base64 48
SECRET_KEY=replace-with-a-long-random-string

# Set true only when the app is served over HTTPS.
COOKIE_SECURE=false

# Set true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Development escape hatch. Never enable in production.
AUTH_DISABLED=false

# --- UniFi controller -------------------------------------------------------
# Base URL of the UniFi OS console (UDM, Cloud Gateway, UNVR, etc.).
# A bare host/IP is accepted and https:// is assumed.
UNIFI_HOST=https://192.168.1.1

# Settings -> Control Plane -> Integrations -> Create New API Key
# Used for the official Integration API (sites, clients, SSID policies).
UNIFI_API_KEY=

# Local-only admin account. Required for client block/unblock, because the
# official Integration API does not expose those actions.
# Create a dedicated local admin with "Restrict to Local Access Only".
UNIFI_USERNAME=
UNIFI_PASSWORD=

# Site selection. Prefer UNIFI_SITE_ID from GET /proxy/network/integration/v1/sites.
# If empty, UNIFI_SITE is matched against the site name/internal reference,
# otherwise the first site is used.
UNIFI_SITE_ID=
UNIFI_SITE=default

# SSID used by the optional MAC allowlist feature (Network 10.0+).
UNIFI_WIFI_NAME=

# Set to false only if the controller has a valid publicly-trusted certificate.
# Prefer UNIFI_CA_BUNDLE for a private CA over disabling verification.
UNIFI_TLS_VERIFY=true
UNIFI_CA_BUNDLE=
UNIFI_TLS_INSECURE=false

# --- Behaviour --------------------------------------------------------------
# Timezone used for schedules unless a device overrides it.
APP_TIMEZONE=UTC

# Discover connected WiFi clients and keep them in the local inventory.
# Clients the controller reports as wired are excluded.
DISCOVERY_ENABLED=true

# Apply desired states (including schedules) automatically in the background.
# Only devices explicitly set to allowed/blocked/scheduled are touched.
AUTO_APPLY=true

# Log intended UniFi calls without making them.
DRY_RUN=false

# Delete audit entries older than this many days. 0 = keep everything forever.
# The UI can override this at runtime. Automatic cleanup runs at most once/day.
AUDIT_RETENTION_DAYS=0

# --- Anonymous install tracking (opt-in) -------------------------------------
# Off by default. When enabled, the app sends a random install ID, version,
# coarse platform, and deployment type once per day. It never sends IP addresses,
# device/network data, or controller details.
TELEMETRY_ENABLED=false
TELEMETRY_URL=https://unifiwifitool.smccloud.com/api/v1/heartbeat
TELEMETRY_INTERVAL_SECONDS=86400
DEPLOYMENT_TYPE=docker

# Background reconciliation loop.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=30

# Experimental: per-SSID MAC allowlist writes via the official API.
# Requires Network 10.0+. Applying a change reprovisions the SSID and can
# briefly disconnect clients.
ENABLE_SSID_ALLOWLIST=false

# --- Storage ----------------------------------------------------------------
# Keep this inside /data. The Compose named volume mounts /data, so the
# database (and its -wal/-shm files) survives container recreation and upgrades.
DATABASE_URL=sqlite:////data/unifi-wifi.db
STATIC_DIR=static
LOG_LEVEL=INFO

# --- Image version ----------------------------------------------------------
# Keep in sync with the VERSION file. Used by docker-compose for the image tag.
IMAGE_VERSION=1.0.0

# --- Host port --------------------------------------------------------------
APP_PORT=8080
